#!/bin/bash

# note: create/open markdown notes under ~/Documents/notes
#
# Usage:
#   note                          # Create diary note
#   note <topic> [title]          # Create note in topic/
#   note open                     # Fuzzy-find existing notes

NOTES_DIR="${HOME}/Documents/notes"
DIARY_DIR="${NOTES_DIR}/diary"

print_help() {
  cat <<'EOF'
Usage: note [topic] [note_name]
       note open

Create and open markdown notes in ~/Documents/notes

Arguments:
  topic          Optional topic/subdirectory for the note
  note_name      Optional name for the note (default: date only)

Commands:
  open           Fuzzy-find and open an existing note

Options:
  -h, --help     Show this help message
EOF
}

resolve_target_file() {
  local first_arg="$1"
  local second_arg="$2"

  if [[ -n "$first_arg" && -f "${NOTES_DIR}/${first_arg}" ]]; then
    printf '%s\n' "${NOTES_DIR}/${first_arg}"
    return 0
  fi

  local label="${first_arg// /_}"
  local note_name="${second_arg// /_}"
  local date_str
  date_str="$(date "+%a_%d-%m-%y")"

  if [[ -n "$label" ]]; then
    mkdir -p "${NOTES_DIR}/${label}"
    if [[ -n "$note_name" ]]; then
      printf '%s\n' "${NOTES_DIR}/${label}/${note_name}-${date_str}.md"
    else
      printf '%s\n' "${NOTES_DIR}/${label}/${date_str}.md"
    fi
  else
    mkdir -p "$DIARY_DIR"
    printf '%s\n' "${DIARY_DIR}/${date_str}.md"
  fi
}

note_fzf() {
  local notes_dir="${HOME}/Documents/notes"
  local selection

  selection=$(
    cd "$notes_dir" || return 1

    fd --type f --extension md | \
      fzf \
        --height 70% --border \
        --prompt 'note> ' \
        --header 'CTRL-F: filenames | CTRL-G: content' \
        --preview 'file="{1}"; line="{2}"; if [ -z "$line" ]; then bat --color=always --line-range :100 "$file"; else start=$(($line>20?$line-20:1)); end=$(($line+20)); bat --color=always --highlight-line "$line" --line-range "${start}:${end}" "$file"; fi' \
        --bind 'ctrl-g:change-prompt(content> )+reload(rg --line-number --no-heading --smart-case . | sed "s|^\\./||")' \
        --bind 'ctrl-f:change-prompt(note> )+reload(fd --type f --extension md)' \
        --delimiter ':'
  )

  [[ -z "$selection" ]] && return

  local file line rest
  if [[ "$selection" == *:* ]]; then
    file="${selection%%:*}"
    rest="${selection#*:}"
    line="${rest%%:*}"
    if [[ "$line" =~ ^[0-9]+$ ]]; then
      nvim "+${line}" "${notes_dir}/${file}"
      return
    fi
  fi

  nvim "${notes_dir}/${selection}"
}

main() {
  local arg1="${1-}"
  local arg2="${2-}"

  case "$arg1" in
    -h|--help)
      print_help
      return 0
      ;;
    open)
      note_fzf
      return 0
      ;;
  esac

  local target_file
  target_file="$(resolve_target_file "$arg1" "$arg2")"
  nvim "$target_file"
}

main "$@"
