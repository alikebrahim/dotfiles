// 1Password desktop app unlock via polkit.
//
// 1Password's polkit policy (com.1password.1Password.policy) requires
// auth_self for the "com.1password.1Password.unlock" action. This causes
// a system password prompt every time the app unlocks, in addition to
// 1Password's own master password. On a single-user workstation this
// adds friction without security benefit — the user already authenticated
// at login.
//
// This rule grants the unlock action silently for members of the wheel
// group (the user's primary admin group). CLI and SSH agent
// authorization actions are left at their default auth_self so that
// terminal-driven access still requires explicit confirmation.

polkit.addRule(function(action, subject) {
    if (action.id == "com.1password.1Password.unlock" &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
