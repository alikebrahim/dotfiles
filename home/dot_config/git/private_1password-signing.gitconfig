# SSH commit signing with a plain file-based ed25519 key (~/.ssh/primary_key).
# The 1Password-agent lines below are kept commented out for reference; the
# agent socket (~/.1password/agent.sock) no longer exists.
[user]
	# 1Password agent-era: public key string
	# signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEcptigfOE1s34Y8TLx78yamv3nAxidgn0aqdnSFKWsV
	signingkey = /home/alikebrahim/.ssh/primary_key
[gpg]
	format = ssh
[gpg "ssh"]
	# 1Password agent-era: agent-only signer
	# program = /opt/1Password/op-ssh-sign
	program = /usr/bin/ssh-keygen
	allowedSignersFile = /home/alikebrahim/.ssh/allowed_signers
[commit]
	gpgsign = true
