{{/* Per-host selection: which target trees this machine gets.
     Patterns are TARGET-relative (match destination paths, e.g.
     ".config/awesome" not "dot_config/awesome"). Rules, from profiles:
     - desktop stack (awesome, quickshell, scripts dir, picom, flameshot):
       servalws only (desktop=true)
     - wezterm: servalws + minisforoum
     - apps (.local/share applications/icons): servalws, minisforoum,
       tima on zotac-box
     - 1Password bits (agent.toml + signing include): servalws, minisforoum
     - .config/themes.gitconfig (delta package) is COMMON — never ignored
     - known_hosts seed: everywhere except honor
*/}}
{{- $facts := index .hostFacts .chezmoi.hostname -}}
{{- if not $facts -}}
{{- fail (printf "No hostFacts entry for hostname %q — add it to home/.chezmoidata.toml" .chezmoi.hostname) }}
{{- end -}}

{{/* ── desktop stack: servalws only ── */}}
{{- if not $facts.desktop }}
.config/awesome
.config/quickshell
.config/scripts
.config/picom
.config/flameshot
.local/bin/theme-apply
.local/bin/theme-select
{{- end }}

{{/* ── wezterm: servalws + minisforoum ── */}}
{{- if not $facts.wezterm }}
.config/wezterm
{{- end }}

{{/* ── apps (.local/share): servalws, minisforoum, tima@zotac-box ── */}}
{{- if not $facts.apps }}
.local/share/applications
.local/share/icons
{{- end }}
{{- if and (eq .chezmoi.hostname "zotac-box") (ne .chezmoi.username "tima") }}
.local/share/applications
.local/share/icons
{{- end }}

{{/* ── 1Password bits: servalws + minisforoum ──
     agent.toml ARCHIVED 2026-08-19: user moved to key-on-disk SSH
     (~/.ssh/primary_key); the agent config is dead, not migrated.
     The signing gitconfig stays — despite the name it is the live
     key-on-disk signing config (primary_key + ssh-keygen). */}}
{{- if not $facts.onepassword }}
.config/git/1password-signing.gitconfig
{{- end }}

{{/* ── app-rewritten state: never managed anywhere ── */}}
.config/nvim/lazy-lock.json

{{/* ── ssh known_hosts seed: honor has none today ── */}}
{{- if eq .chezmoi.hostname "honor" }}
.ssh/known_hosts
{{- end }}

{{/* ── fleet secrets file: only hosts flagged secrets=true ──
     (honor first, 2026-08-22; others carry the encrypted blob in the
     repo but deploy nothing). Also requires the age identity to exist
     on this host — without it chezmoi cannot decrypt, so the target
     must not be scheduled at all. */}}
{{- $noSecrets := or (not (index $facts "secrets")) (not (stat (joinPath .chezmoi.homeDir ".config/age/age.identity.txt"))) }}
{{- if $noSecrets }}
.config/secrets.env
{{- end }}

{{/* ── thinkpad (Omarchy 4.0) ──
     Thinkpad-only overrides managed by the repo: the Hyprland keybinding
     overrides (bindings.lua), the Omarchy customisations (menu clone +
     vendor patches/hooks), the Omarchy-specific helper scripts, and the
     merged tmux XDG config (~/.config/tmux/tmux.conf). The SHARED personal
     tmux (~/.tmux.conf + ~/.tmux/theme tree) stays for the other hosts and
     is NOT deployed on thinkpad. Omarchy also owns the nvim theme
     pipeline, so the repo's kanagawa (theme) plugin spec is skipped on
     thinkpad. */}}
{{- if ne .chezmoi.hostname "thinkpad" }}
.config/hypr
.config/omarchy
.config/tmux/tmux.conf
.local/bin/omarchy-menu-keybindings
.local/bin/scratch-term
{{- end }}

{{- if eq .chezmoi.hostname "thinkpad" }}
.bashrc
.bash_profile
.config/nvim/lua/plugins/kanagawa.lua
.tmux.conf
{{- end }}
