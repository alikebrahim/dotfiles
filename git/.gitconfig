[credential]
	helper = store
[user]
	name = Ali K. Ebrahim
	email = alikebrahim@me.com
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[core]
    pager = delta
    editor = nvim

[interactive]
    diffFilter = delta --color-only

[include]
    path = ~/.config/delta/themes.gitconfig

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true

    dark = true
    features = collared-trogon
     ; light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

# 1Password SSH signing — only present on hosts with 1Password installed
# (servalws, minisforoum). Stowed via the 1Password package. Git silently
# ignores the include if the file does not exist.
[include]
    path = ~/.config/git/1password-signing.gitconfig
